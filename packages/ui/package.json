{
  "name": "@coss-app/ui",
  "version": "0.1.2",
  "description": "coss 公司通用 UI 組件庫（shadcn/ui + Tailwind v4）",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "lint.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./components/*": {
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./globals.css": "./dist/styles/globals.css",
    "./lint.json": "./lint.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp -r src/styles dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.2",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.68.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.18.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coss-app/ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/coss-app/ui/issues"
  },
  "homepage": "https://ui.coss.com.tw"
}
