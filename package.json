{
  "name": "coss-ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "npm run build -w @coss-app/ui",
    "typecheck": "npm run typecheck -w @coss-app/ui",
    "storybook": "npm run storybook -w @coss-app/docs",
    "build-storybook": "npm run build-storybook -w @coss-app/docs",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "manifest": "node scripts/build-manifest.mjs",
    "check:deps": "node scripts/check-no-shadcn-dep.mjs",
    "lint": "eslint . && node scripts/check-no-comments.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:shadcn-css": "node scripts/check-shadcn-css.mjs",
    "check:patterns": "node scripts/check-patterns.mjs",
    "verify": "npm run typecheck && npm run typecheck -w @coss-app/docs && npm run lint && npm test && npm run manifest -- --check && npm run check:deps && npm run check:shadcn-css && npm run check:patterns"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/css": "^2.0.1",
    "@shadcn/lint": "0.2.5",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "tailwind-csstree": "^0.4.2"
  }
}
