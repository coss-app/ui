{
  "name": "coss-ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "npm run build -w @coss-app/ui",
    "typecheck": "npm run typecheck -w @coss-app/ui",
    "storybook": "npm run storybook -w @coss-app/docs",
    "build-storybook": "npm run build-storybook -w @coss-app/docs",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "manifest": "node scripts/build-manifest.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0"
  }
}
